# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key           # public; used by the browser for realtime + read
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # SECRET; server-only, used to insert events

# Shared secret the feeders (iOS Shortcut, Zapier, webhooks) must send.
# Generate one: openssl rand -hex 32
INGEST_TOKEN=replace-with-a-long-random-secret
